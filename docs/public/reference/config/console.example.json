{
  "format_version": 1,
  "default_preset": "review",
  "presets": {
    "review": {"type": "split", "dir": "col", "ratio": 0.62,
      "a": {"type": "region", "tabs": ["workspace.diff", "workspace.files"]},
      "b": {"type": "region", "tabs": ["workspace.terminal", "session.plan", "session.tasks"]}},
    "build": {"type": "split", "dir": "col", "ratio": 0.55,
      "a": {"type": "split", "dir": "row", "ratio": 0.5,
        "a": {"type": "region", "tabs": ["workspace.files"]},
        "b": {"type": "region", "tabs": ["workspace.diff"]}},
      "b": {"type": "region", "tabs": ["workspace.terminal"]}},
    "focus": {"type": "region", "tabs": ["workspace.diff", "workspace.terminal", "workspace.files", "session.plan"]}
  },
  "split_clamp": [0.15, 0.85],
  "min_region_px": {"width": 240, "height": 160},
  "workspace_width_px": 560,
  "recently_closed": 8,
  "keymap": {"hide_workspace": "Meta+.", "show_files": "Meta+Shift+Y", "open_in_editor": "Meta+Shift+O", "tag_session": "t"},
  "editor_scheme": "vscode://file",
  "native_open_links": true,
  "diff": {"side_by_side_min_width": 900, "word_wrap": true, "highlight_words": true, "group_by_folder": true, "hide_whitespace": false,
    "fetch_concurrency": 4,
    "stale_after_seconds": 30,
    "base_ref": "",
    "max_files": 500,
    "max_status_entries": 2000,
    "max_file_bytes": 2097152,
    "context_lines": 3,
    "max_refs": 50,
    "git_timeout_seconds": 20},
  "edits_page_size": 200,
  "files": {"max_entries_per_dir": 2000, "max_read_bytes": 1048576},
  "transcript": {"default_profile": "conversation", "role_profiles": {"helper": "agent-review", "follower": "agent-review"}},
  "session_organization": {"row_tags_max": 6, "recent_tag_toggles": 4, "bulk_selection_max": 200,
    "views_max": 60, "views_visible": 12, "handoffs_ended_visible": 3, "views_file_bytes_max": 262144, "count_refresh_ms": 4000,
    "query_bytes_max": 600, "query_terms_max": 24, "glob_expansion_max": 200, "text_hit_limit": 200,
    "board_column_cards_max": 200, "board_columns_max": 12, "board_placement_rules_max": 24,
    "vocabulary_max": 400, "tag_request_bytes_max": 262144, "tag_index_rows_max": 250000,
    "kept_sessions_max": 2000, "kept_text_documents_max": 4000},
  "models": {"refresh_after_seconds": 300, "min_refresh_seconds": 10, "discovery_timeout_seconds": 20,
    "discovery_output_max_bytes": 8388608, "max_entries": 1000, "max_id_bytes": 256, "max_label_bytes": 200}
}
