    {
      "id": "memory.search",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "searchMemory",
          "listMemory"
        ]
      },
      "tag": {
        "key": "memory",
        "value": "search"
      },
      "coverage": {
        "enumerable": true
      }
    },
