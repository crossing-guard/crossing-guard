    {
      "_comment": "Ships with NO in-house hosts on purpose: the standard library cannot know your network, and guessing would mislabel someone else's traffic as in-house. Out of the box only loopback and RFC1918 resolve in-house; everything else resolves external (fail-safe). To declare your own network, override this detector by id in your overlay \u2014 add in_house_hosts / in_house_suffixes and keep the id 'net.dest'. See: how-to/recipes.md.",
      "id": "net.dest",
      "kind": "destination",
      "roles": [
        "tool_call"
      ],
      "in_house_hosts": [],
      "in_house_suffixes": [],
      "in_house_cidrs": [
        "10.0.0.0/8",
        "192.168.0.0/16",
        "127.0.0.0/8"
      ],
      "coverage": {
        "enumerable": true,
        "gaps": [
          "everything not listed resolves external (fail-safe)",
          "no in-house hosts are declared by default \u2014 until you override this detector, every non-private destination resolves external"
        ]
      },
      "scope": "resource"
    },
    {
