{
  "_comment": "Crossing Guard portable structural detector floor. Framework asset: deterministic action/tool facts only; no business, sensitivity, behavior, workflow-phase, architecture, destination-trust, risk, threshold, or consequence policy.",
  "detectors": [
    {
      "id": "memory.search",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "searchMemory",
          "listMemory"
        ]
      },
      "tag": {
        "key": "memory",
        "value": "search"
      },
      "coverage": {
        "enumerable": true
      }
    },
    {
      "id": "memory.read",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "getMemory"
        ]
      },
      "tag": {
        "key": "memory",
        "value": "read"
      },
      "coverage": {
        "enumerable": true
      }
    },
    {
      "id": "memory.write",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "upsertMemory"
        ]
      },
      "tag": {
        "key": "memory",
        "value": "write"
      },
      "coverage": {
        "enumerable": true
      }
    },
    {
      "id": "memory.delete",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "deleteMemory"
        ]
      },
      "tag": {
        "key": "memory",
        "value": "delete"
      },
      "coverage": {
        "enumerable": true
      }
    },
    {
      "id": "fs.read",
