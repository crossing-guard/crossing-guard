      ],
      "match": {
        "tool": [
          "Read"
        ]
      },
      "tag": {
        "key": "fs",
        "value": "read"
      },
      "coverage": {
        "enumerable": true
      }
    },
    {
      "id": "fs.edit",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "Edit",
          "NotebookEdit",
