    {
      "id": "plan.todo",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "TodoWrite",
          "TaskCreate",
          "TaskUpdate"
        ]
      },
      "tag": {
        "key": "plan",
