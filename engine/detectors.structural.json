      }
    },
    {
      "id": "exec.run",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "Bash",
          "shell",
          "local_shell",
          "exec_command"
        ]
      },
      "tag": {
        "key": "exec",
        "value": "run"
      },
      "coverage": {
        "enumerable": true
      }
    },
    {
      "id": "search.code",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
        "tool": [
          "Grep",
          "Glob"
        ]
      },
      "tag": {
        "key": "search",
        "value": "code"
      },
      "coverage": {
        "enumerable": true,
        "gaps": [
          "shell grep/rg/find is tagged via the command channel, not here"
        ]
      }
    },
    {
      "id": "search.web",
      "kind": "source",
      "roles": [
        "tool_call"
      ],
      "match": {
