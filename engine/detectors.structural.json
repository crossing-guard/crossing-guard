      }
    },
    {
      "id": "vcs.commit",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bgit\\s+commit\\b",
      "tag": {
        "key": "vcs",
        "value": "commit"
      },
      "coverage": {
        "enumerable": true,
        "gaps": [
          "command channel; commit-message prose can still collide"
        ]
      },
      "evidence": "raw"
    },
    {
      "id": "vcs.push",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bgit\\s+push\\b",
      "tag": {
        "key": "vcs",
        "value": "push"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "vcs.push.force",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bgit\\s+push\\b.*(--force|-f)\\b",
      "tag": {
        "key": "vcs",
        "value": "push-force"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "vcs.diff",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bgit\\s+diff\\b",
      "tag": {
