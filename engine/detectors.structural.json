        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "vcs.branch",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bgit\\s+(checkout|switch|branch)\\b",
      "tag": {
        "key": "vcs",
        "value": "branch"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "vcs.reset.hard",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bgit\\s+reset\\s+--hard\\b",
      "tag": {
        "key": "vcs",
        "value": "reset-hard"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "exec.sudo",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\bsudo\\s",
      "tag": {
        "key": "exec",
        "value": "sudo"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "net.egress",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(curl|wget)\\s",
      "tag": {
        "key": "net",
        "value": "egress"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "remote.ssh",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(ssh|scp|sftp)\\s",
      "tag": {
        "key": "remote",
        "value": "ssh"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "search.grep",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(grep|rg|ag|ack|find)\\s",
      "tag": {
        "key": "search",
        "value": "code"
      },
      "coverage": {
        "enumerable": true,
        "gaps": [
          "shell code-search; complements the Grep/Glob tool detector"
        ]
      },
      "evidence": "raw"
    },
    {
      "id": "db.read",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(psql|mysql|sqlite3|mongosh)\\b|SELECT\\s.+\\sFROM\\s",
      "tag": {
        "key": "db",
        "value": "read"
      },
      "coverage": {
        "enumerable": true,
        "gaps": [
          "SELECT…FROM shape or a db client binary"
        ]
      },
      "evidence": "raw"
    },
    {
      "id": "test.run",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(go\\s+test|pytest|npm\\s+test|jest|phpunit|vitest)\\b",
      "tag": {
        "key": "test",
        "value": "run"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    },
    {
      "id": "build.run",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(go\\s+build|make\\s|npm\\s+run\\s+build|cargo\\s+build|mvn\\s)\\b",
      "tag": {
        "key": "build",
        "value": "run"
      },
      "coverage": {
        "enumerable": true,
        "gaps": [
          "'make ' with trailing space to avoid the English word"
        ]
      },
      "evidence": "raw"
    },
    {
      "id": "pkg.install",
      "kind": "pattern",
      "roles": [
        "tool_call"
      ],
      "regex": "\\b(npm\\s+i(nstall)?|pip\\s+install|go\\s+get|brew\\s+install|apt(-get)?\\s+install|cargo\\s+add)\\b",
      "tag": {
        "key": "pkg",
        "value": "install"
      },
      "coverage": {
        "enumerable": true
      },
      "evidence": "raw"
    }
  ]
}
