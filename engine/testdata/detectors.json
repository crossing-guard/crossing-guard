{
  "_comment": "P2 detector config — user-editable. Each detector FIRES DETERMINISTICALLY on an event and DECLARES its coverage (known gaps + optional measured miss-rate). There is NO per-tag confidence. The four kinds: source (classify by the channel the data came through — the strongest, only the user can map their infra), destination (in-house allowlist), pattern (a known shape), content (keywords — unknowable gaps, a floor only).",
  "detectors": [
    {
      "id": "srcmap:orders",
      "kind": "source",
      "match": { "tool": ["getCustomerAddress", "getOrder", "getOrders", "getWarehouseOrders", "getOrderById"] },
      "tag": { "key": "data-class", "value": "personal-data" },
      "coverage": { "enumerable": true, "gaps": ["only the listed order tools; a new order tool is a visible, closable hole"] }
    },
    {
      "id": "srcmap:finance",
      "kind": "source",
      "match": { "tool": ["listPayments", "getPayoutReport", "getFeeEstimate"] },
      "tag": { "key": "data-class", "value": "regulated" },
      "coverage": { "enumerable": true, "gaps": ["listed finance tools only"] }
    },
    {
      "id": "srcmap:vendor-cost",
      "kind": "source",
      "match": { "tool": ["getSupplierPrice", "compareSupplierPrices", "getPurchaseRecord"] },
      "tag": { "key": "data-class", "value": "internal" },
      "coverage": { "enumerable": true, "gaps": ["listed cost/margin tools only"] }
    },
    {
      "id": "srcmap:public-catalog",
      "kind": "source",
      "match": { "tool": ["getProduct", "searchCatalogItems", "getCatalogItem"] },
      "tag": { "key": "data-class", "value": "public" },
      "coverage": { "enumerable": true }
    },
    {
      "id": "srcmap:db-prod",
      "kind": "source",
      "match": { "source_prefix": ["db:prod"], "path_prefix": ["exports/", "/exports/"] },
      "tag": { "key": "data-class", "value": "customer-data" },
      "coverage": { "enumerable": true, "gaps": ["declared prod DB / exports paths only"] }
    },
    {
      "id": "allowlist:in-house",
      "kind": "destination",
      "in_house_hosts": ["inventory.example.internal", "admin.example.internal", "internal.example.com"],
      "in_house_suffixes": [".internal.example.com"],
      "in_house_cidrs": ["10.0.0.0/8", "192.168.0.0/16"],
      "coverage": { "enumerable": true, "gaps": ["everything NOT listed resolves to 'external' (fail-safe)"] }
    },
    {
      "id": "pattern:cust-id",
      "kind": "pattern",
      "regex": "\\bCUS-\\d{8}\\b",
      "tag": { "key": "data-class", "value": "personal-data" },
      "coverage": { "enumerable": true, "gaps": ["only the CUS-\\d{8} format we declared"] }
    },
    {
      "id": "pattern:aws-key",
      "kind": "pattern",
      "regex": "AKIA[0-9A-Z]{16}",
      "tag": { "key": "data-class", "value": "credential-material" },
      "coverage": { "enumerable": false, "gaps": ["novel key formats", "obfuscation", "split across events"], "measured_miss_rate": null }
    },
    {
      "id": "pattern:ssn",
      "kind": "pattern",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "tag": { "key": "data-class", "value": "personal-data" },
      "coverage": { "enumerable": false, "gaps": ["unformatted / spaced SSNs", "9-digit runs"] }
    },
    {
      "id": "pattern:email",
      "kind": "pattern",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "tag": { "key": "data-class", "value": "personal-data" },
      "coverage": { "enumerable": false, "gaps": ["obfuscated emails (name [at] domain)"] }
    },
    {
      "id": "builtin:memory-store",
      "kind": "source",
      "match": { "tool": ["upsertMemory", "getMemory", "searchMemory", "listMemory", "deleteMemory"], "path_prefix": ["/.control-plane/memory", "/.claude/projects/"] },
      "tag": { "key": "memory-access", "value": "touched" },
      "coverage": { "enumerable": true, "gaps": ["listed memory stores/tools only; the read-vs-write split lives in the ledger extractor (sessionindex), not this event classifier"] }
    },
    {
      "id": "content:mna",
      "kind": "content",
      "keywords": ["acquisition", "merger", "term sheet", "due diligence", "pre-public", "material non-public"],
      "tag": { "key": "data-class", "value": "regulated" },
      "coverage": { "enumerable": false, "gaps": ["UNKNOWABLE — there is no shape for 'sensitive business intel'; this keyword list is a floor only, not coverage"] }
    }
  ]
}
