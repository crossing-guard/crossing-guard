{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crossing-guard:schema:handoff-receipt:1.0",
  "title": "Handoff receipt (immutable; one transition of one handoff, reported by one device)",
  "description": "A receipt's id is deterministic over (handoff, transition, device, ticket, native session id), so a retry is byte-identical. started and opened carry the recipient's session; the others carry none.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "handoff_id",
    "transition",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/typedId"
    },
    "handoff_id": {
      "$ref": "common.schema.json#/$defs/typedId"
    },
    "transition": {
      "type": "string",
      "enum": [
        "received",
        "started",
        "opened",
        "declined",
        "closed",
        "withdrawn"
      ]
    },
    "ticket_id": {
      "$ref": "common.schema.json#/$defs/typedId"
    },
    "session": {
      "$ref": "common.schema.json#/$defs/session"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transition": {
            "enum": [
              "started",
              "opened"
            ]
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "required": [
          "ticket_id",
          "session"
        ]
      }
    }
  ]
}
