{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crossing-guard:schema:handoff:1.1",
  "title": "Handoff between members (immutable; the sender's redacted document)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session",
    "repository_id",
    "created_at",
    "created_by",
    "recipient",
    "title",
    "body_markdown",
    "remaining",
    "agents",
    "governance_state",
    "anchors_scope",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/typedId"
    },
    "session": {
      "$ref": "common.schema.json#/$defs/session"
    },
    "repository_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id"
      ],
      "properties": {
        "user_id": {
          "$ref": "common.schema.json#/$defs/typedId"
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "remaining": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "name",
          "source_digest",
          "bundle_digest"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256-v1:[a-f0-9]{64}$"
          },
          "bundle_digest": {
            "type": "string",
            "pattern": "^sha256-v1:[a-f0-9]{64}$"
          }
        }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turns",
        "truncated"
      ],
      "properties": {
        "turns": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "role",
              "text"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 65536
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "governance_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water_mark",
        "tags"
      ],
      "properties": {
        "water_mark": {
          "type": "string",
          "maxLength": 100
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "value": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "anchors_scope": {
      "const": "sender-local"
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "description": "1.1: a title, a typed recipient (a server user id), the sender's remaining list, references to shared agents, and an optional conversation excerpt. The server stamps sender and recipient from the authenticated device and its membership table; it never trusts created_by."
}
